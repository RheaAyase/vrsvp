# https://editorconfig.org/

# Do not search any further up the file system tree for overriding configs for this project
root = true

# Settings for all files
[*]

# File character encoding: latin1, utf-8, utf-16be, utf-16le
charset = utf-8
# Format of line endings: lf, crlf, cr
end_of_line = lf
# Number of columns used for each indentation level
indent_size = 4
# How to handle indentations when the "tab" key is used: space, tab
indent_style = tab
# Whether newlines should end a file: true, false
insert_final_newline = true
# Whether whitespace should be trimmed: true, false
trim_trailing_whitespace = true

# Settings for YAML files
[*.{md,yml,yaml}]

indent_size = 2
indent_style = space
